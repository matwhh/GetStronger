node_modules/
package-lock.json

# Генерується tools/build-meta.js із домену в js/config.js.
# У репозиторії тримати не варто: він привʼязаний до конкретного домену.
sitemap.xml

# Експорти акаунта з кнопки «Резервна копія»: пошта, історія тренувань,
# рейтинг. Одного разу такий файл уже лежав у корені й роздавався по
# HTTP — тому і тут, і в .vercelignore, і в tools/ci-hygiene.mjs.
backup-*.json
*backup-*.json

# Дампи бази з db/backup-export.sql (пошта всіх користувачів, профілі,
# історія ELO). Лежать на Mac у ~/Desktop/forge-backups/ і в git не їдуть
# ніколи. Див. db/RESTORE.md.
forge-backup-*.json

# Службове й архіви.
.DS_Store
*.zip

# Файл-запит на публікацію: його кладе доставка, а tools/auto-publish.sh
# читає перший рядок як текст коміта й одразу прибирає. У репозиторії
# йому робити нічого.
.forge-publish

# Логи браузерних перевірок у CI (tools/ci-browser.sh).
.ci-browser/

# Тека-звалище для файлів, які треба прибрати вручну: доставка з хмари
# вміє створювати й переписувати файли, але не видаляти. Замість rm
# сміття переїжджає сюди — і в репозиторії йому робити нічого.
_to_delete/

# INV-005. Вихід симуляції 90 днів: 2290 файлів (82 МБ) — 91 % усіх файлів
# репозиторію. Це десять профілів Chromium (leveldb, sqlite, кеш), логи й
# чекпоінти одного прогону. Сайту, тестам і CI вони не потрібні, але
# потрапляли в кожен clone і в кожну перевірку гігієни.
#
# Дані в них синтетичні (пошта u1@sim.local…u10@sim.local, токени вигляду
# tok-8-1788352339106 від мок-хмари) — справжніх акаунтів там немає,
# перевірено. Сам harness (run.mjs, personas.mjs, analyze.mjs, REPORT.md)
# лишається в git: відтворити прогін можна, а тягати його вихід — ні.
tools/sim90/out/
